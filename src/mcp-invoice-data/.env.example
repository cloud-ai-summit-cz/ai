# ============================================================================
# MCP Invoice Data Server Configuration
# ============================================================================

# Server host and port
HOST=0.0.0.0
PORT=8014

# API key for authentication
API_KEY=your-api-key-here

# ============================================================================
# External workflow callbacks
# ============================================================================

# Required for the send_report tool
SEND_REPORT_LOGIC_APP_URL=https://example.logic.azure.com/workflows/.../invoke?...&sig=<redacted>

# Required for the create_event tool
CREATE_EVENT_LOGIC_APP_URL=https://example.logic.azure.com/workflows/.../invoke?...&sig=<redacted>

# ============================================================================
# Observability - Application Insights
# ============================================================================
# Get connection string from Terraform:
#   terraform output -raw application_insights_connection_string

# Optional for local development unless you want telemetry exported
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# Feature flags
DEBUG=false
